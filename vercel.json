{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "dist/public",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.cjs" },
    { "src": "/uploads/(.*)", "dest": "/api/index.cjs" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
