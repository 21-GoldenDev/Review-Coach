# Required
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string

# Optional
PORT=5000
ADMIN_EMAIL=admin@ratemycoach.site
# Persistent upload folder on VPS (default: ./uploads next to the app)
# UPLOADS_DIR=/var/lib/ratemycoach/uploads

# SMTP (contact form)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
