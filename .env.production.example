# Copy to .env on your Linux VPS:  cp .env.production.example .env
# Or run: npm run setup:vps  (creates dirs and sets UPLOADS_DIR)

NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string

# Persistent uploads (created by script/setup-vps.sh)
UPLOADS_DIR=/var/lib/ratemycoach/uploads

ADMIN_EMAIL=admin@ratemycoach.site

# SMTP (contact form) — optional
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
